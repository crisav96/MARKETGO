<section class="contacto">

    <div class="contacto-cabecera">

        <h2><i class="bi bi-telephone-fill"></i> Contáctanos</h2>

        <p>¿Tienes dudas, sugerencias o necesitas ayuda con un pedido? Escríbenos.</p>

    </div>

    <div class="contacto-grid">

        <div class="contacto-info">

            <div class="contacto-persona">

                <div class="contacto-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <h3>Cristopher Arroyo Villalobos</h3>
                    <span>Atención al cliente — MarketGo</span>
                </div>

            </div>

            <ul class="contacto-datos">

                <li>
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>San José, Costa Rica</span>
                </li>

                <li>
                    <i class="bi bi-telephone-fill"></i>
                    <span>+506 8888-8888</span>
                </li>

                <li>
                    <i class="bi bi-envelope-fill"></i>
                    <span>cristopher@marketgo.com</span>
                </li>

                <li>
                    <i class="bi bi-clock-fill"></i>
                    <span>Lun. a sáb.: 7:00 a.m. – 7:00 p.m.<br>Dom.: 9:00 a.m. – 2:00 p.m.</span>
                </li>

            </ul>

            <div class="contacto-social">

                <a href="#"><i class="bi bi-facebook"></i></a>
                <a href="#"><i class="bi bi-instagram"></i></a>
                <a href="#"><i class="bi bi-whatsapp"></i></a>

            </div>

        </div>

        <form action="/contacto" method="POST" class="formulario contacto-form">

            <div class="campo">
                <label>Nombre</label>
                <input type="text" name="nombre" required>
            </div>

            <div class="campo">
                <label>Correo electrónico</label>
                <input type="email" name="correo" required>
            </div>

            <div class="campo">
                <label>Mensaje</label>
                <textarea name="mensaje" rows="5" required></textarea>
            </div>

            <button type="submit" class="btn-auth">
                <i class="bi bi-send-fill"></i>
                Enviar mensaje
            </button>

        </form>

    </div>

</section>
