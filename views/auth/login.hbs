<h2>Iniciar Sesión</h2>

<form action="/auth/login" method="POST" class="formulario">

    <div class="campo">
        <label>Correo electrónico</label>

        <input
            type="email"
            name="correo"
            required>
    </div>

    <div class="campo">
        <label>Contraseña</label>

        <input
            type="password"
            name="password"
            required>
    </div>

    <button type="submit" class="btn-auth">

        <i class="bi bi-box-arrow-in-right"></i>
        Iniciar Sesión

    </button>

    <p>
        ¿No tienes cuenta? <a href="/auth/registro">Crear cuenta</a>
    </p>

</form>