<section class="categorias">

    <div class="container">

        <div class="section-title">

            <h2>Categorías</h2>

            <p>Encuentra todo lo que necesitas</p>

        </div>

        <div class="categorias-grid">

            {{#each categorias}}

                <a href="/productos?categoria={{id}}" class="categoria-card">

                    <span class="categoria-icono">{{icono}}</span>

                    <h3>{{nombre}}</h3>

                </a>

            {{else}}

                <p class="categorias-vacio">Aún no hay categorías disponibles.</p>

            {{/each}}

        </div>

    </div>

</section>
