<div class="admin-cabecera">

    <h1>
        <i class="bi bi-box-seam"></i>
        {{#if producto}}Editar producto{{else}}Nuevo producto{{/if}}
    </h1>

    <p>Completa la información del producto.</p>

</div>

<div class="admin-panel admin-panel-form">

    <form
        action="{{#if producto}}/admin/productos/editar/{{producto.id}}{{else}}/admin/productos{{/if}}"
        method="POST"
        enctype="multipart/form-data"
        class="formulario">

        <div class="admin-form-fila">

            <div class="campo">
                <label>Nombre</label>
                <input type="text" name="nombre" value="{{producto.nombre}}" required>
            </div>

            <div class="campo">

                <label>Categoría</label>

                <select name="categoriaId" required>

                    <option value="" disabled {{#unless producto}}selected{{/unless}}>
                        Selecciona...
                    </option>

                    {{#each categorias}}

                        <option value="{{id}}" {{#if seleccionada}}selected{{/if}}>
                            {{nombre}}
                        </option>

                    {{/each}}

                </select>

            </div>

        </div>

        <div class="campo">
            <label>Descripción</label>
            <textarea name="descripcion" rows="3">{{producto.descripcion}}</textarea>
        </div>

        <div class="admin-form-fila">

            <div class="campo">
                <label>Precio (₡)</label>
                <input type="number" name="precio" step="0.01" min="0.01" value="{{producto.precio}}" required>
            </div>

            <div class="campo">
                <label>Precio de oferta (₡)</label>
                <input type="number" name="precioOferta" step="0.01" min="0.01" value="{{producto.precioOferta}}">
                <small>Déjalo vacío si el producto no está en oferta.</small>
            </div>

            <div class="campo">
                <label>Stock</label>
                <input type="number" name="stock" min="0" step="1" value="{{producto.stock}}" required>
            </div>

        </div>

        <div class="campo">

            <label>Imagen del producto</label>

            {{#if producto.imagen}}

                <div class="admin-imagen-actual">

                    <img
                        src="/img/productos/{{producto.imagen}}"
                        alt="{{producto.nombre}}"
                        onerror="this.onerror=null; this.src='/img/productos/default.png';">

                    <span>Imagen actual — sube otra para reemplazarla</span>

                </div>

            {{/if}}

            <div id="previewImagen" class="admin-imagen-actual" hidden>

                <img id="previewImagenImg" src="" alt="Vista previa">

                <span>Vista previa de la nueva imagen</span>

            </div>

            <input type="file" name="imagen" accept="image/*">

        </div>

        <div class="admin-form-acciones">

            <a href="/admin/productos" class="btn-admin-secundario">
                Cancelar
            </a>

            <button type="submit" class="btn-admin">
                <i class="bi bi-check-lg"></i>
                {{#if producto}}Guardar cambios{{else}}Crear producto{{/if}}
            </button>

        </div>

    </form>

</div>
