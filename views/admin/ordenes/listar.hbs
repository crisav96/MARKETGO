<div class="admin-cabecera">

    <h1><i class="bi bi-receipt"></i> Pedidos</h1>

    <p>Administra todos los pedidos de MarketGo.</p>

</div>

<div class="admin-panel">

    <div class="admin-toolbar">

        <form method="GET" action="/admin/ordenes" class="admin-filtros">

            <input
                type="text"
                name="buscar"
                placeholder="Buscar por cliente, correo o # de pedido..."
                value="{{buscar}}">

            <select name="estado">

                <option value="">Todos los estados</option>

                {{#each estados}}

                    <option value="{{valor}}" {{#if seleccionado}}selected{{/if}}>
                        {{valor}}
                    </option>

                {{/each}}

            </select>

            <button type="submit" class="btn-admin-secundario">
                <i class="bi bi-search"></i> Filtrar
            </button>

        </form>

    </div>

    <div class="admin-tabla-wrap">

        <table class="admin-tabla">

            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                {{#each ordenes}}

                    <tr>

                        <td>#{{id}}</td>

                        <td>{{nombreCliente}}</td>

                        <td>{{fechaFormateada}}</td>

                        <td>₡{{total}}</td>

                        <td>
                            <span class="badge-estado badge-{{estadoClase}}">
                                {{estado}}
                            </span>
                        </td>

                        <td>
                            <a href="/admin/ordenes/{{id}}" class="btn-admin-secundario btn-admin-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>

                    </tr>

                {{else}}

                    <tr>
                        <td colspan="6" class="admin-tabla-vacia">
                            No se encontraron pedidos.
                        </td>
                    </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</div>
